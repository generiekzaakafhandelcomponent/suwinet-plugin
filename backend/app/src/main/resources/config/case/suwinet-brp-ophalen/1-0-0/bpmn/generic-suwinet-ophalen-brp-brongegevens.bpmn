    <bpmn:sequenceFlow id="JaSequenceFlow2" name="ja" sourceRef="HeeftKinderenGateway" targetRef="OphalenBRPKinderenGegevensTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kinderenBsns  != "" &amp;&amp; kinderenBsns.size() &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0wh6hna" sourceRef="Gateway_0j9g2o1" targetRef="Event_0k8t5dy" />
    <bpmn:sequenceFlow id="Flow_0wa981u" sourceRef="VoorbereidenProcesVariabelenTask" targetRef="HeeftPartnerGateway" />
    <bpmn:exclusiveGateway id="BsnInBrpBekendGateway" name="bsn in brp bekend?" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_1qe90bb</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
