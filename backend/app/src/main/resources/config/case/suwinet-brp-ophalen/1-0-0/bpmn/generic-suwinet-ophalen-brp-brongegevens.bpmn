// common functions
function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }

    return list;
}

function mapAdres(adres) {
    if (!adres) return null;
    var hasData = adres.straatnaam != null || adres.huisnr != null || adres.huisletter != null
        || adres.huisnrtoevoeging != null || adres.postcd != null || adres.woonplaatsnaam != null
        || adres.aanduidingBijHuisnr != null || adres.locatieoms != null;
    if (!hasData) return null;
    return {
        straatnaam: adres.straatnaam != null ? String(adres.straatnaam) : '',
        huisnummer: adres.huisnr != null ? Number(adres.huisnr) : 0,
        huisletter: adres.huisletter != null ? String(adres.huisletter) : '',
        huisnummertoevoeging: adres.huisnrtoevoeging != null ? String(adres.huisnrtoevoeging) : '',
        postcode: adres.postcd != null ? String(adres.postcd) : '',
        woonplaatsnaam: adres.woonplaatsnaam != null ? String(adres.woonplaatsnaam) : '',
        aanduidingBijHuisnummer: adres.aanduidingBijHuisnr != null ? String(adres.aanduidingBijHuisnr) : '',
        locatieomschrijving: adres.locatieoms != null ? String(adres.locatieoms) : ''
    };
}

// mapping functions for BRP
function mapVerblijfstitel(vt) {
    return {
        codeVerblijfstitel: {
            code: vt != null &amp;&amp; vt.cdVerblijfstitel != null ? String(vt.cdVerblijfstitel) : '-1',
            name: vt != null &amp;&amp; vt.cdVerblijfstitel != null ? String(vt.cdVerblijfstitel) : '',
        },
        datumAanvangVerblijfstitel: vt != null &amp;&amp; vt.datBVerblijfstitel != null ? String(vt.datBVerblijfstitel) : '',
        datumEindeVerblijfstitel: vt != null &amp;&amp; vt.datEVerblijfstitel != null ? String(vt.datEVerblijfstitel) : ''
    };
}



function mapNationaliteiten(nationaliteit) {
    if (!nationaliteit) return null;

    return nationaliteit
        .filter(function(n) {
            var rawCode = n.cdNationaliteit != null ? String(n.cdNationaliteit).trim() : '';
            return rawCode !== '' &amp;&amp; !isNaN(parseInt(rawCode, 10));
        })
        .map(function(n) {
            var parsedCode = String(parseInt(String(n.cdNationaliteit).trim(), 10));

            if (!Object.prototype.hasOwnProperty.call(CODES_NATIONALITEIT, parsedCode)) {
                parsedCode = '0';
            }

            return {
                code: parsedCode,
                name: CODES_NATIONALITEIT[parsedCode]
            };
        });
}

function mapVerblijfplaatsHistorisch(historisch) {
    if (!historisch) return null;

    return historisch.map(v =&gt; {
        var aangifteObj = v.aangifteAdreshoudingBrp != null ? v.aangifteAdreshoudingBrp : null;
        var datBegin = aangifteObj != null &amp;&amp; aangifteObj.datBAdreshoudingBrp != null
            ? String(aangifteObj.datBAdreshoudingBrp)
            : '';
        return {
            type: v.type != null ? String(v.type) : 'WOONADRES',
            adres: mapAdres(v.domicilieAdres),
            datumBeginAdreshouding: datBegin
        };
    });
}

function mapBrpGegevensGeheim(code) {
    if (code == null) return 'GEEN_GEHEIMHOUDING';
    var codeStr = String(code).trim();
    switch (codeStr) {
        case '0': return 'GEEN_GEHEIMHOUDING';
        case '1': return 'GEGEVENS_GEHEIM';
        case '2': return 'NIET_KERKEN';
        case '3': return 'NIET_VRIJE_DERDEN';
        case '4': return 'NIET_KERKEN_DERDEN';
        case '5': return 'NIET_DERDEN_ALGEMEEN';
        case '6': return 'NIET_KERKEN_VRIJE_DERDEN';
        case '7': return 'NIET_KERKEN_VRIJE_DERDEN_ALGEMEEN_DERDEN';
        default:  return 'GEEN_GEHEIMHOUDING';
    }
}

function adressenGelijk(adres1, adres2) {
    if (adres1 == null || adres2 == null) return false;
    return adres1.straatnaam === adres2.straatnaam &amp;&amp;
        adres1.huisnummer === adres2.huisnummer &amp;&amp;
        adres1.huisletter === adres2.huisletter &amp;&amp;
        adres1.huisnummertoevoeging === adres2.huisnummertoevoeging &amp;&amp;
        adres1.postcode === adres2.postcode &amp;&amp;
        adres1.woonplaatsnaam === adres2.woonplaatsnaam;
}


function convertToPersoonDto(brpData) {
    var huwelijk = brpData.huwelijk;
    var eersteHuwelijk = (huwelijk &amp;&amp; huwelijk.length &gt; 0) ? huwelijk[0] : null;
    var partner = eersteHuwelijk ? eersteHuwelijk.partner : null;

    var kinderen = brpData.kind;
    var kinderenBsns = [];
    if (kinderen &amp;&amp; kinderen.length &gt; 0) {
        kinderenBsns = kinderen
            .map(k =&gt; k.burgerservicenr != null ? String(k.burgerservicenr) : null)
            .filter(bsn =&gt; bsn != null);
    }

    var overlijden = brpData.overlijden;
    var datumOverlijden = overlijden ? (overlijden.datOverlijden != null ? String(overlijden.datOverlijden) : '') : '';

    return {
        voornamen: brpData.voornamen != null ? String(brpData.voornamen) : '',
        voorvoegsel: brpData.voorvoegsel != null ? String(brpData.voorvoegsel) : '',
        achternaam: brpData.significantDeelVanDeAchternaam != null ? String(brpData.significantDeelVanDeAchternaam) : '',
        geboortedatum: brpData.geboortedat != null ? String(brpData.geboortedat) : '',
        bsn: brpData.burgerservicenr != null ? String(brpData.burgerservicenr) : '',
        adresBrp: mapAdres(brpData.domicilieAdres),
        postadresBrp: mapAdres(brpData.correspondentieadres),
        verblijfstitel: mapVerblijfstitel(brpData.verblijfstitel),
        verblijfplaatsHistorisch: mapVerblijfplaatsHistorisch(brpData.verblijfplaatsHistorisch),
        nationaliteiten: mapNationaliteiten(brpData.nationaliteit),
        kinderenBsns: kinderenBsns,
        partnerBsn: partner ? (partner.burgerservicenr != null ? String(partner.burgerservicenr) : '') : '',
        geslachtsnaamPartner: partner ? (partner.significantDeelVanDeAchternaam != null ? String(partner.significantDeelVanDeAchternaam) : '') : '',
        ingangsdatumHuwelijk: eersteHuwelijk ? (eersteHuwelijk.datHuwelijkssluiting != null ? String(eersteHuwelijk.datHuwelijkssluiting) : '') : '',
        datumOverlijden: datumOverlijden,
        codeBrpGegevensGeheim: mapBrpGegevensGeheim(brpData.cdBrpGegevensGeheim),
        anummer: brpData.aNr != null ? String(brpData.aNr) : '',
        naamgebruik: brpData.aanduidingNaamgebruik != null ? String(brpData.aanduidingNaamgebruik) : '',
        geslachtsAanduiding: brpData.geslacht != null ? String(brpData.geslacht) : ''
    };
}

// process functionality

var kinderenInfoList = execution.getVariable('brpPersoonsgegevensKinderenInfoRaw');

print(kinderenInfoList);

if (kinderenInfoList) {
    var kinderenDtos = [];
    for (var i = 0; i &lt; kinderenInfoList.size(); i++) {
        var item = kinderenInfoList.get(i);
        var brpData = item.dynamicProperties;
        if (brpData) {
            kinderenDtos.push(convertToPersoonDto(brpData));
        }
    }
    execution.setVariable('brpPersoonsgegevensKinderenInfo', toJavaValue(kinderenDtos));
}</camunda:script>
        </camunda:executionListener>
