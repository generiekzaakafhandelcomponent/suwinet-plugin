    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HeeftPartnerGateway" targetRef="OphalenBRPPartnerGegevensTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${partnerBsn != ""}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1fjo3oc" sourceRef="OphalenBRPPartnerGegevensTask" targetRef="Gateway_130n1nh" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="nee" sourceRef="HeeftPartnerGateway" targetRef="Gateway_130n1nh" />
    <bpmn:sequenceFlow id="Flow_01qrzj7" sourceRef="Gateway_130n1nh" targetRef="HeeftKinderenGateway" />
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="nee" sourceRef="BsnInBrpBekendGateway" targetRef="Gateway_0j9g2o1" />
    <bpmn:sequenceFlow id="JaSequenceFlow1" name="ja" sourceRef="BsnInBrpBekendGateway" targetRef="VoorbereidenProcesVariabelenTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('brpPersoonsgegevensInfo')}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0yekogb" sourceRef="OphalenBRPKinderenGegevensTask" targetRef="Gateway_0mm9x3l" />
    <bpmn:sequenceFlow id="NeeSequenceFlow2" name="Nee" sourceRef="HeeftKinderenGateway" targetRef="Gateway_0mm9x3l" />
