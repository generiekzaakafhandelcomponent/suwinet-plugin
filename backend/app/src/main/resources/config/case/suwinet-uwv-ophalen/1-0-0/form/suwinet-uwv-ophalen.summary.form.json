{
    "display": "form",
    "components": [
        {
            "label": "createdon",
            "applyMaskOn": "change",
            "tableView": true,
            "key": "pv.createdOn",
            "properties": {
                "sourceKey": "case:createdOn"
            },
            "type": "hidden",
            "input": true
        },
        {
            "label": "aanvraag",
            "key": "gegevensVanuitAanvraag",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "bronnen",
            "key": "gegevensVanuitBronnen",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Columns",
            "key": "columnsSamenvatting",
            "type": "columns",
            "input": false,
            "tableView": false,
            "columns": [
                {
                    "components": [
                        {
                            "label": "Aanvrager",
                            "tableView": false,
                            "key": "uwvContainerAanvrager",
                            "type": "container",
                            "title": "Aanvrager",
                            "input": false,
                            "customClass": "border-around-formio-container",
                            "components": [
                                {
                                    "label": "aanvragerHTML",
                                    "refreshOnChange": false,
                                    "customClass": "no-border-around-formio-container",
                                    "key": "aanvragerHtml",
                                    "type": "htmlelement",
                                    "tableView": false,
                                    "input": false,
                                    "content": "<h4>Aanvrager</h4>\n<section>\n  <dl class=\"row mb-0\">\n    <dd class=\"col-6\">Burgerservicenummer</dd>\n    <dt class=\"col-6\">{{{ data?.gegevensVanuitAanvraag?.bsn || '-' }}}</dt>\n  </dl>\n  <dl class=\"row mb-0\">\n    <dd class=\"col-6\">UWV inkomsten (polisadministratie)</dd>\n    <dt class=\"col-6\">{{{ data?.gegevensVanuitBronnen?.uwv?.status?.inkomsten || 'Nog niet opgehaald' }}}</dt>\n  </dl>\n  <dl class=\"row mb-0\">\n    <dd class=\"col-6\">UWV werknemersverzekeringen</dd>\n    <dt class=\"col-6\">{{{ data?.gegevensVanuitBronnen?.uwv?.status?.werknemersverzekeringen || 'Nog niet opgehaald' }}}</dt>\n  </dl>\n</section>"
                                }
                            ]
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                },
                {
                    "components": [
                        {
                            "label": "Maatregelen",
                            "tableView": false,
                            "key": "uwvContainerMaatregelen",
                            "type": "container",
                            "title": "Maatregelen",
                            "input": false,
                            "customClass": "border-around-formio-container",
                            "components": [
                                {
                                    "label": "maatregelenHTML",
                                    "refreshOnChange": false,
                                    "customClass": "no-border-around-formio-container",
                                    "key": "maatregelenHtml",
                                    "type": "htmlelement",
                                    "tableView": false,
                                    "input": false,
                                    "content": "<h4>Maatregelen en kortingen UWV-uitkering</h4>\n{% var fmt = function(d) { return d ? moment(d).format('DD-MM-YYYY') : '-'; };\nvar rows = [];\n((data?.gegevensVanuitBronnen?.uwv?.werknemersverzekeringen?.uitkeringsverhouding) || []).forEach(function(uv) {\n  (uv?.uitkeringsperiode || []).forEach(function(up) {\n    (up?.redenMaatregelMbtUitkeringUwv || []).forEach(function(m) {\n      rows.push({ wet: uv?.szWet?.cdSzWet, periode: fmt(up?.datBUitkeringsperiode) + ' t/m ' + fmt(up?.datEUitkeringsperiode),\n        maatregel: fmt(m?.datBMaatregelMbtUitkering) + ' t/m ' + fmt(m?.datEMaatregelMbtUitkering),\n        korting: m?.percKortingUitkering ? ((m.percKortingUitkering.cdPositiefNegatief || '') + (m.percKortingUitkering.percentage || '-')) : '-',\n        reden: m?.cdRedenMaatregelMbtUitkeringUwv });\n    });\n  });\n}); %}\n{% if (rows.length === 0) { %}<p>Geen maatregelen gevonden.</p>{% } else { %}\n<table class=\"table table-sm\">\n  <thead><tr><th>Wet (CdSzWet)</th><th>Uitkeringsperiode</th><th>Maatregel</th><th>Korting (ruwe waarde)</th><th>Reden (code)</th></tr></thead>\n  <tbody>\n  {% rows.forEach(function(r) { %}<tr><td>{{{ r.wet ?? '-' }}}</td><td>{{{ r.periode }}}</td><td>{{{ r.maatregel }}}</td><td>{{{ r.korting }}}</td><td>{{{ r.reden ?? '-' }}}</td></tr>{% }); %}\n  </tbody>\n</table>\n<p><small>Korting is de ruwe Suwinet-waarde (CdPositiefNegatief + 5-cijferig Percentage), nog niet omgerekend.</small></p>\n{% } %}"
                                }
                            ]
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                }
            ]
        },
        {
            "label": "Columns",
            "key": "columnsBronnen",
            "type": "columns",
            "input": false,
            "tableView": false,
            "columns": [
                {
                    "components": [
                        {
                            "label": "UWV inkomsten",
                            "tableView": false,
                            "key": "uwvContainerInkomsten",
                            "type": "container",
                            "title": "UWV inkomsten",
                            "input": false,
                            "customClass": "border-around-formio-container",
                            "components": [
                                {
                                    "label": "inkomstenHTML",
                                    "refreshOnChange": false,
                                    "customClass": "no-border-around-formio-container",
                                    "key": "inkomstenHtml",
                                    "type": "htmlelement",
                                    "tableView": false,
                                    "input": false,
                                    "content": "<h4>UWV inkomsten (polisadministratie) &ndash; alle gegevens</h4>\n{% var esc = function(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); };\nvar render = function(v) {\n  if (v === null || v === undefined || v === '') { return '-'; }\n  if (Array.isArray(v)) {\n    if (v.length === 0) { return '-'; }\n    return v.map(function(item, i) { return '<div class=\"border-start ps-2 mb-2\"><em>#' + (i + 1) + '</em>' + render(item) + '</div>'; }).join('');\n  }\n  if (typeof v === 'object') {\n    var keys = Object.keys(v);\n    if (keys.length === 0) { return '-'; }\n    return '<dl class=\"row mb-0\">' + keys.map(function(k) { return '<dd class=\"col-5 mb-0\">' + esc(k) + '</dd><dt class=\"col-7 mb-0\">' + render(v[k]) + '</dt>'; }).join('') + '</dl>';\n  }\n  return esc(v);\n}; %}\n{{ render(data?.gegevensVanuitBronnen?.uwv?.inkomsten) }}"
                                }
                            ]
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                },
                {
                    "components": [
                        {
                            "label": "UWV werknemersverzekeringen",
                            "tableView": false,
                            "key": "uwvContainerWerknemersverzekeringen",
                            "type": "container",
                            "title": "UWV werknemersverzekeringen",
                            "input": false,
                            "customClass": "border-around-formio-container",
                            "components": [
                                {
                                    "label": "werknemersverzekeringenHTML",
                                    "refreshOnChange": false,
                                    "customClass": "no-border-around-formio-container",
                                    "key": "werknemersverzekeringenHtml",
                                    "type": "htmlelement",
                                    "tableView": false,
                                    "input": false,
                                    "content": "<h4>UWV werknemersverzekeringen &ndash; alle gegevens</h4>\n{% var esc = function(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); };\nvar render = function(v) {\n  if (v === null || v === undefined || v === '') { return '-'; }\n  if (Array.isArray(v)) {\n    if (v.length === 0) { return '-'; }\n    return v.map(function(item, i) { return '<div class=\"border-start ps-2 mb-2\"><em>#' + (i + 1) + '</em>' + render(item) + '</div>'; }).join('');\n  }\n  if (typeof v === 'object') {\n    var keys = Object.keys(v);\n    if (keys.length === 0) { return '-'; }\n    return '<dl class=\"row mb-0\">' + keys.map(function(k) { return '<dd class=\"col-5 mb-0\">' + esc(k) + '</dd><dt class=\"col-7 mb-0\">' + render(v[k]) + '</dt>'; }).join('') + '</dl>';\n  }\n  return esc(v);\n}; %}\n{{ render(data?.gegevensVanuitBronnen?.uwv?.werknemersverzekeringen) }}"
                                }
                            ]
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                }
            ]
        }
    ]
